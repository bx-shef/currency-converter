# Скопировать в .env.prod на сервере рядом с docker-compose.prod.yml
# НЕ коммитить .env.prod в git!

# Домен сайта (DNS должен указывать на IP сервера)
DOMAIN=currency.example.com

# Email для SSL-сертификата Let's Encrypt
LETSENCRYPT_EMAIL=admin@example.com

# Яндекс.Метрика — задаётся в GitHub Secrets, не здесь
# (запекается в Docker-образ при сборке CI)
# NUXT_PUBLIC_YANDEX_COUNTER_ID=

# ─── Инструменты для AI-агента shef.cowork (docs/MCP.md) ──────────────────
# Пусто хоть одно из трёх — инструменты и экран «Ключ для shef.cowork» отвечают «не настроено»,
# сайт и виджет работают как обычно.
# client_id и client_secret приложения «Конвертер валют» из кабинета партнёра Битрикс24 (Маркет).
B24_CLIENT_ID=
B24_CLIENT_SECRET=
# Ключ шифрования ключей подключения в Redis: 32 случайных байта в base64.
# Сгенерировать: openssl rand -base64 32 и сохранить копию в менеджере паролей. Сменили или потеряли этот ключ
# либо том Redis — все выданные ключи подключения недействительны, администраторам порталов выпускать их заново.
ENCRYPTION_KEY=
# Пароль Redis (контейнер redis в docker-compose.prod.yml). Сгенерировать: openssl rand -hex 24
REDIS_PASSWORD=

# Необязательно: лимиты контейнера приложения (по умолчанию 512m памяти и 1 CPU).
# APP_MEM_LIMIT=512m
# APP_CPUS=1
