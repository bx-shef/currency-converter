# Яндекс.Метрика — ID счётчика (только цифры, получить на metrika.yandex.ru)
NUXT_PUBLIC_YANDEX_COUNTER_ID=

# Разрешённые хосты для dev-сервера (через запятую)
# Нужно при использовании туннелей (ngrok, localtunnel и т.д.)
NUXT_ALLOWED_HOSTS=

# Публичный адрес приложения. Нужен для проверки установки в портал через туннель:
# из него строится абсолютный адрес обработчика виджета, без него /install
# откажется его регистрировать. В проде задаётся переменной CI (см. docs/PROCESS.md §0.2).
NUXT_PUBLIC_SITE_URL=

# Ссылка на приложение в Маркете Bitrix24 (промо-карточка под калькулятором).
# Пусто → берётся константа MARKETPLACE_URL из app/utils/site.ts.
NUXT_PUBLIC_MARKETPLACE_URL=

# Автор в подвале. Пусто → значения по умолчанию из nuxt.config.ts.
NUXT_PUBLIC_AUTHOR_NAME=
NUXT_PUBLIC_AUTHOR_URL=

# Коммит сборки для ссылки «сборка <sha>» в подвале.
# Локально задавать не нужно — в CI подставляется автоматически.
NUXT_PUBLIC_COMMIT_SHA=
